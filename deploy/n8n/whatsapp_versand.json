  {
   "id": "c293fb15-06d5-5320-8aaa-5bef152ec406",
   "name": "Zählen",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    1760,
    300
   ],
   "parameters": {
    "jsCode": "\nconst S = {}; for (const r of $input.all()) if (r.json && r.json.key) S[r.json.key] = Number(r.json.anzahl) || 0;\nconst n = $('Ergebnis').all().filter(r => r.json.ok).length; if (!n) return [];\nreturn [{ json: { key: 'wa|sent', mail: 'wa', typ: 'sent', anzahl: (S['wa|sent'] || 0) + n } }];\n"
   },
   "executeOnce": true
  },
