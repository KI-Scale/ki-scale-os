      }
     ]
    }
   }
  },
  {
   "id": "69c0b7b2-37e1-5024-85a1-637b472e92b7",
   "name": "Plätze prüfen",
   "type": "n8n-nodes-base.dataTable",
   "typeVersion": 1.1,
   "position": [
    110,
    300
   ],
   "parameters": {
    "operation": "get",
    "dataTableId": {
     "__rl": true,
     "value": "__STATS__",
     "mode": "id"
    },
    "filters": {
     "conditions": [
      {
       "keyName": "key",
       "keyValue": "wa|buy"
      }
     ]
    },
    "limit": 1
   },
   "alwaysOutputData": true
  },
  {
   "id": "4efcbfe6-f5be-541b-98e3-2ff06fd708e6",
   "name": "Einstellungen",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    220,
    300
   ],
   "parameters": {
    "jsCode": "\n// ===== Einstellungen =====\nconst MODUS = 'aus';          // 'aus' | 'live'\nconst PRO_TAG = 100;          // Nachrichten pro Tag\nconst VON = 9, BIS = 20;      // nur zwischen 9 und 20 Uhr (deutsche Zeit)\nconst PHONE_ID = '__PHONE_ID__';\nconst PLAETZE = 1000000;      // keine Platzgrenze (Verknappung läuft über die 72-Std.-Frist pro Lead)\n// =========================\nif (MODUS === 'aus' || PHONE_ID.startsWith('__')) return [];\nconst verkauft = Number(($('Plätze prüfen').first().json || {}).anzahl) || 0;\nif (verkauft >= PLAETZE) return [];\nconst now = new Date();\nconst h = Number(now.toLocaleString('en-GB', { timeZone: 'Europe/Berlin', hour: '2-digit', hour12: false }));\nif (h < VON || h >= BIS) return [];\nconst tag = now.toLocaleDateString('sv-SE', { timeZone: 'Europe/Berlin' });\nconst sd = $getWorkflowStaticData('global'); if (sd.tag !== tag) { sd.tag = tag; sd.heute = 0; }\nconst rest = Math.max(0, PRO_TAG - (sd.heute || 0)); if (!rest) return [];\nconst laeufe = Math.max(1, BIS - h);\nreturn [{ json: { limit: Math.max(1, Math.ceil(rest / laeufe)), phoneId: PHONE_ID } }];\n"
   }
  },
  {
   "id": "2e8e6f05-c199-50bd-b2dc-9ee55853b8fc",
   "name": "Nächste Leads",
   "type": "n8n-nodes-base.dataTable",
   "typeVersion": 1.1,
   "position": [
    440,
    300
   ],
   "parameters": {
    "operation": "get",
    "dataTableId": {
     "__rl": true,
     "value": "__WA__",
     "mode": "id"
    },
    "matchType": "allConditions",
    "filters": {
     "conditions": [
      {
       "keyName": "status",
       "keyValue": "aktiv"
      },
      {
       "keyName": "gesendet",
       "keyValue": "-"
      },
      {
       "keyName": "gekauft",
       "keyValue": "-"
      }
     ]
    },
    "limit": "={{ $json.limit }}"
   }
  },
  {
   "id": "4cdccc45-eb3e-547a-b5d0-149aee228c16",
   "name": "Nachrichten bauen",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    660,
    300
   ],
   "parameters": {
    "jsCode": "\nconst E = $('Einstellungen').first().json;\nconst T = { geld: 'fp_geld', zeit: 'fp_zeit', noshow: 'fp_termin', standard: 'fp_standard' };\nreturn $input.all().map(i => i.json).filter(L => L && L.token && L.telefon).map(L => {\n  const name = (L.vorname && L.vorname !== '-') ? L.vorname.split(' ')[0] : 'du';\n  return { json: { token: L.token, url: 'https://graph.facebook.com/v21.0/' + E.phoneId + '/messages', body: {\n    messaging_product: 'whatsapp', to: String(L.telefon).replace(/\\D/g, ''), type: 'template',\n    template: { name: T[L.gruppe] || 'fp_standard', language: { code: 'de' }, components: [\n      { type: 'body', parameters: [{ type: 'text', text: name }] },\n      { type: 'button', sub_type: 'url', index: '0', parameters: [{ type: 'text', text: L.token }] }] } } } };\n});\n"
   }
  },
  {
   "id": "19c53c56-31b1-5527-a456-1091706409f5",
   "name": "An WhatsApp senden",
   "type": "n8n-nodes-base.httpRequest",
   "typeVersion": 4.2,
   "position": [
    880,
    300
   ],
   "parameters": {
    "method": "POST",
    "url": "={{ $json.url }}",
    "authentication": "genericCredentialType",
    "genericAuthType": "httpHeaderAuth",
    "sendBody": true,
    "specifyBody": "json",
    "jsonBody": "={{ JSON.stringify($json.body) }}",
    "options": {
     "batching": {
      "batch": {
       "batchSize": 1,
       "batchInterval": 1500
      }
     }
    }
   },
   "onError": "continueRegularOutput"
  },
  {
   "id": "1e45de28-2298-50f4-aaf3-c2ab01e08571",
   "name": "Ergebnis",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    1100,
    300
   ],
   "parameters": {
    "jsCode": "\nconst sent = $('Nachrichten bauen').all(); const out = [];\n$input.all().forEach((r, i) => { const m = sent[i]?.json; if (!m) return; const ok = !!(r.json && r.json.messages);\n  out.push({ json: { token: m.token, gesendet: ok ? new Date().toISOString() : 'fehler', ok, fehler: ok ? '' : JSON.stringify(r.json?.error || r.json).slice(0, 200) } }); });\nconst sd = $getWorkflowStaticData('global'); sd.heute = (sd.heute || 0) + out.filter(o => o.json.ok).length;\nsd.letzterLauf = { zeit: new Date().toISOString(), ok: out.filter(o => o.json.ok).length, fehler: out.filter(o => !o.json.ok).length };\nreturn out;\n"
   }
  },
