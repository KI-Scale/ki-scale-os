  {
   "id": "c293fb15-06d5-5320-8aaa-5bef152ec406",
   "name": "Zählen",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    2220,
    300
   ],
   "parameters": {
    "jsCode": "\nconst stats = {}; for (const r of $('Zähler holen').all()) if (r.json && r.json.key) stats[r.json.key] = Number(r.json.anzahl) || 0;\nconst add = {}; for (const r of $('Ergebnis').all()) if (!r.json.failed) { const k = r.json.mailId + '|sent'; add[k] = (add[k] || 0) + 1; }\nreturn Object.entries(add).map(([key, n]) => ({ json: { key, mail: key.split('|')[0], typ: 'sent', anzahl: (stats[key] || 0) + n } }));\n"
   }
  },
