  {
   "id": "55f98dcf-0c6d-531f-81d8-7f799c3e74a7",
   "name": "Mails bauen",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    1120,
    300
   ],
   "parameters": {
    "jsCode": "\nconst MAILS = __MAILS__;\nconst BASE = 'https://n8n.ki-scale.com/webhook/';\nconst out = [];\nfor (const it of $input.all()) {\n  const L = it.json; if (!L || !L.token) continue;\n  const P = $('Plan').all().find(p => p.json.phase === L._phase)?.json || $('Plan').first().json;\n  const field = L._phase;\n  let id = field === 'm1' ? '1' + (L.variante || 'A') : field.slice(1);\n  if (field === 'm2b') {   // nur, wenn der Klick mindestens 1 Std. her ist (grob über m1/m2-Zeit)\n    const last = Date.parse(L.m2 !== '-' ? L.m2 : L.m1); if (!last || Date.now() - last < 3600e3) continue;\n  }\n  const T = MAILS[id]; if (!T) continue;\n  const name = String(L.vorname || '').trim().split(' ')[0];\n  const q = 't=' + L.token + '&m=' + id;\n  const rep = s => s.split('{{VORNAME_SP}}').join(name ? ' ' + name : '').split('{{VORNAME}}').join(name).split('{{FRIST}}').join(P.frist)\n    .split('{{KLICK}}').join(BASE + 'fp-c?' + q + '&z=lp').split('{{KLICK_CAL}}').join(BASE + 'fp-c?' + q + '&z=cal')\n    .split('{{ABMELDEN}}').join(BASE + 'fp-u?' + q).split('{{PIXEL}}').join(BASE + 'fp-o?' + q);\n  let subject = T.subject; if (!name) subject = subject.replace(', {{VORNAME}}', '');\n  const html = rep(T.html);\n  const text = html.replace(/<style[\\s\\S]*?<\\/style>/g, '').replace(/<a [^>]*href=\"([^\"]+)\"[^>]*>([\\s\\S]*?)<\\/a>/g, '$2 ($1)').replace(/<br\\s*\\/?>/g, '\\n').replace(/<\\/(p|div|tr|h\\d)>/g, '\\n').replace(/<[^>]+>/g, '').replace(/&nbsp;/g, ' ').replace(/\\n\\s*\\n+/g, '\\n\\n').trim();\n  out.push({ json: { to: L.email, token: L.token, field, mailId: id,\n    body: { FromEmailAddress: 'Adrian Lewu <adrian@mail.adrian-lewu.de>', ReplyToAddresses: ['team@ki-scale.com'], Destination: { ToAddresses: [L.email] },\n      Content: { Simple: { Subject: { Data: rep(subject), Charset: 'UTF-8' }, Body: { Html: { Data: html, Charset: 'UTF-8' }, Text: { Data: text, Charset: 'UTF-8' } },\n        Headers: [{ Name: 'List-Unsubscribe', Value: '<' + BASE + 'fp-u?' + q + '>' }, { Name: 'List-Unsubscribe-Post', Value: 'List-Unsubscribe=One-Click' }] } } } } });\n}\nreturn out;\n"
   }
  },
  {
   "id": "8c9f1fab-a2a3-5be6-a48c-d26c9f9d4870",
   "name": "An Amazon SES senden",
   "type": "n8n-nodes-base.httpRequest",
   "typeVersion": 4.2,
   "position": [
    1340,
    300
   ],
   "parameters": {
    "method": "POST",
    "url": "https://email.eu-central-1.amazonaws.com/v2/email/outbound-emails",
    "authentication": "predefinedCredentialType",
    "nodeCredentialType": "aws",
    "sendBody": true,
    "specifyBody": "json",
    "jsonBody": "={{ JSON.stringify($json.body) }}",
    "options": {
     "batching": {
      "batch": {
       "batchSize": 10,
       "batchInterval": 1000
      }
     }
    }
   },
   "credentials": {
    "aws": {
     "id": "__AWS__",
     "name": "Amazon SES"
    }
   },
   "onError": "continueRegularOutput"
  },
  {
   "id": "1e45de28-2298-50f4-aaf3-c2ab01e08571",
   "name": "Ergebnis",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    1560,
    300
   ],
   "parameters": {
    "jsCode": "\nconst sent = $('Mails bauen').all();\nconst res = $input.all();\nconst ok = [], fail = [];\nres.forEach((r, i) => { const m = sent[i]?.json; if (!m) return; (r.json && r.json.MessageId ? ok : fail).push({ json: { token: m.token, field: m.field, mailId: m.mailId, fehler: r.json && r.json.error ? JSON.stringify(r.json.error).slice(0, 200) : '' } }); });\n$getWorkflowStaticData('global').letzterLauf = { zeit: new Date().toISOString(), ok: ok.length, fehler: fail.length };\nreturn ok.concat(fail.map(f => ({ json: { ...f.json, failed: true } })));\n"
   }
  },
